# OpenAI API Key for AI-powered assessment generation & response evaluation
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (default: gpt-4o, fallback: gpt-4o-mini)
OPENAI_MODEL=gpt-4o

# Base URL (optional, for custom OpenAI compatible endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1
